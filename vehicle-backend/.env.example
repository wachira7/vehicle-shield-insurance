# Copy to .env (never commit .env)
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# Optional: role holders (default: deployer)
QUOTE_SIGNER_ADDRESS=
ASSESSOR_ADDRESS=
TREASURER_ADDRESS=
PAUSER_ADDRESS=

# Optional: real stablecoin; leave empty to deploy MockUSDC
USDC_ADDRESS=
# Optional: whole USDC to mint into the pool when using MockUSDC
SEED_POOL_USDC=100000

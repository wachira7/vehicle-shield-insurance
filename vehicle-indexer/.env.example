# Copy to .env (never commit .env)
# "sepolia" (committed deployment) or "localhost" (local Hardhat node)
INDEXER_NETWORK=sepolia
# RPC endpoint for that network; defaults to http://127.0.0.1:8545 for localhost
INDEXER_RPC_URL=
# Comma-separated browser origins allowed to call /v1/*
CORS_ORIGINS=http://localhost:3000

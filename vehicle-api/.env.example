# Copy to .env (never commit .env)
PORT=8787

# Key that signs quotes. Must hold QUOTE_SIGNER_ROLE on InsuranceCore.
QUOTE_SIGNER_PRIVATE_KEY=

# Secret salt for on-chain vehicle ids. Never change it after launch:
# every existing policy's vehicle id depends on it.
VEHICLE_ID_SALT=

# Which deployment to quote for: a committed network name, or a JSON file
# written by vehicle-backend's deploy script (for a local Hardhat node).
DEPLOYMENT_NETWORK=sepolia
# DEPLOYMENT_FILE=../packages/protocol/deployments/localhost.json

# Testnet only: sign quotes for vehicles that haven't been verified yet.
ALLOW_UNVERIFIED_VEHICLES=false

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# Postgres connection string; "pglite:<dir>" uses embedded Postgres on disk (development)
DATABASE_URL=pglite:./.data/pglite

# Signs session tokens. At least 32 random characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Host the frontend is served from; Sign-In with Ethereum messages must name it.
SIWE_DOMAIN=localhost:3000

# Encrypts every photo before it is stored. 64 hex characters, e.g. `openssl rand -hex 32`.
# Losing it makes stored photos unreadable; changing it does too.
PHOTO_ENCRYPTION_KEY=

# Filebase (IPFS) storage: create a bucket on the IPFS network and an access key.
# Leave all three empty to store photos on local disk (LOCAL_STORAGE_DIR) instead.
FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
FILEBASE_BUCKET=
# LOCAL_STORAGE_DIR=./.data/blobs
